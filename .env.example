# ==============================================================================
# TETHLOGS SERVICES LTD - ENVIRONMENT CONFIGURATION
# ==============================================================================

# 1. DATABASE (PostgreSQL - Neon, Supabase, Railway, or Local PostgreSQL)
# Example: postgresql://username:password@ep-sample-pooler.us-east-1.aws.neon.tech/neondb?sslmode=require
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/tethlogs?sslmode=prefer"

# 2. FREE REAL-TIME EMAIL DISPATCH (Nodemailer / Standard SMTP)
# For standard Gmail:
#   1. Go to Google Account -> Security -> Enable 2-Step Verification
#   2. Generate an "App Password" (16 characters, e.g. "abcd efgh ijkl mnop")
#   3. Paste below:
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="465"
SMTP_USER="your-email@gmail.com"
SMTP_PASS="your-16-character-app-password"

# 3. NOTIFICATION RECIPIENT
# Email address that receives immediate dispatch alerts whenever a customer submits
# a service ticket, quotation request, or inquiry:
ALERT_EMAIL_RECIPIENT="support@tethlogs.com"
SMTP_FROM="\"TETHLOGS Dispatch Desk\" <dispatch@tethlogs.com>"
